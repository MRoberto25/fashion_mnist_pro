    "            hm_big = cv2.resize(hm, (28*sc, 28*sc))\n",
    "            hm_col = cv2.applyColorMap(np.uint8(255*hm_big), cv2.COLORMAP_INFERNO)\n",
    "            overlay = cv2.cvtColor((hm_col*0.55 + orig_rgb*0.45).astype(np.uint8),\n",
    "                                   cv2.COLOR_BGR2RGB)\n",
    "            axes[row,1].imshow(cv2.cvtColor(hm_col, cv2.COLOR_BGR2RGB))\n",
    "            axes[row,2].imshow(overlay)\n",
    "        else:\n",
    "            for c in [1,2]:\n",
    "                axes[row,c].text(0.5,0.5,'N/A',ha='center',va='center',color='gray')\n",
    "        axes[row,1].axis('off')\n",
    "        axes[row,2].axis('off')\n",
    "\n",
