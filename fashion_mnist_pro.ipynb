    "---\n",
    "## 4. Test-Time Augmentation (TTA) <a id='4'></a>\n",
    "\n",
    "**TTA** rulează modelul pe 8 variante ale aceleiași imagini și mediază predicțiile.\n",
    "Rezultat: robustețe crescută, erori aleatoare reduse, +1-2% acuratețe efectivă."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_with_tta(model, img_array):\n",
    "    \"\"\"8-variant TTA: original + flip + brightness ×2 + shifts ×4.\"\"\"\n",
    "    base = img_array[0, :, :, 0]\n",
    "    augmentations = [\n",
    "        ('Original',          base.copy()),\n",
    "        ('Flip orizontal',    base[:, ::-1]),\n",
    "        ('Luminozitate +10%', np.clip(base * 1.1, 0, 1)),\n",
    "        ('Luminozitate -10%', np.clip(base * 0.9, 0, 1)),\n",
    "        ('Shift jos  1px',    np.roll(base,  1, axis=0)),\n",
    "        ('Shift sus  1px',    np.roll(base, -1, axis=0)),\n",
    "        ('Shift dr.  1px',    np.roll(base,  1, axis=1)),\n",
    "        ('Shift st.  1px',    np.roll(base, -1, axis=1)),\n",
    "    ]\n",
    "    preds = []\n",
    "    for _, aug in augmentations:\n",
    "        batch = aug[np.newaxis, :, :, np.newaxis]\n",
    "        preds.append(model.predict(batch, verbose=0)[0])\n",
    "    return np.mean(preds, axis=0), augmentations\n",
    "\n",
    "\n",
    "print('predict_with_tta() definit — 8 variante de augmentare.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Grad-CAM — Explainable AI <a id='5'></a>\n",
    "\n",
    "### Problema „Black Box"\n",
    "\n",
    "Cum verificăm că modelul a *înțeles* forma gheatei și nu a memorat textura fundalului?\n",
    "\n",
    "**Grad-CAM** calculează gradientul scorului de clasă față de feature map-ul ultimului strat convoluțional:\n",
    "\n",
    "$$\\alpha_k^c = \\frac{1}{Z} \\sum_{i,j} \\frac{\\partial y^c}{\\partial A_{ij}^k} \\qquad L^c = \\text{ReLU}\\left(\\sum_k \\alpha_k^c \\cdot A^k\\right)$$\n",
    "\n",
    "### Soluție Originală pentru Keras 3 + Custom Layers\n",
    "\n",
    "Keras 3 nu expune `output_shape` pentru layere subclassed — metoda clasică de a construi un sub-model nu funcționează. Soluție implementată: **forward hook** la nivel de clasă Python."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_gradcam_layer(model):\n",
    "    \"\"\"Layer-ul imediat înaintea GlobalAveragePooling2D — ideal pentru Grad-CAM.\"\"\"\n",
    "    for i, layer in enumerate(model.layers):\n",
    "        if isinstance(layer, keras.layers.GlobalAveragePooling2D) and i > 0:\n",
    "            target = model.layers[i - 1]\n",
    "            print(f'Hook Grad-CAM: {target.name} ({type(target).__name__})')\n",
    "            return target\n",
    "    return None\n",
    "\n",
    "\n",
    "def generate_gradcam(model, img_array, pred_idx, hook_layer):\n",
    "    \"\"\"\n",
    "    Grad-CAM cu forward hook — compatibil cu orice arhitectură custom.\n",
    "\n",
    "    Algoritm:\n",
    "      1. Patchuim __call__ al clasei layer-ului țintă\n",
    "      2. Captăm feature map-ul A^k în GradientTape\n",
    "      3. grads = tape.gradient(score, A^k)\n",
    "      4. alpha_k = mean(grads, spatial dims)\n",
    "      5. heatmap = ReLU(sum_k alpha_k * A^k_spatial_mean)\n",
    "    \"\"\"\n",
    "    if hook_layer is None:\n",
    "        return None\n",
    "\n",
    "    captured = []\n",
    "    orig = hook_layer.__class__.__call__\n",
    "\n",
    "    def hooked(self_layer, inputs, *a, **kw):\n",
    "        out = orig(self_layer, inputs, *a, **kw)\n",
    "        if self_layer is hook_layer:\n",
    "            captured.append(out)\n",
    "        return out\n",
    "\n",
    "    try:\n",
    "        hook_layer.__class__.__call__ = hooked\n",
    "        x = tf.Variable(img_array.astype('float32'))\n",
    "        with tf.GradientTape() as tape:\n",
    "            preds = model(x, training=False)\n",
    "            score = preds[:, pred_idx]\n",
    "        hook_layer.__class__.__call__ = orig\n",
    "\n",
    "        if not captured or captured[0].ndim != 4:\n",
    "            return None\n",
    "\n",
    "        conv_out = captured[0]\n",
    "        grads    = tape.gradient(score, conv_out)\n",
    "        if grads is None:\n",
    "            return None\n",
    "\n",
    "        pooled  = tf.reduce_mean(grads, axis=(0, 1, 2)).numpy()\n",
    "        cam     = conv_out[0].numpy().copy()\n",
    "        for i in range(pooled.shape[-1]):\n",
    "            cam[:, :, i] *= pooled[i]\n",
    "        heatmap = np.maximum(np.mean(cam, axis=-1), 0)\n",
    "        if heatmap.max() > 0:\n",
    "            heatmap /= heatmap.max()\n",
    "        return heatmap\n",
    "\n",
    "    except Exception as e:\n",
    "        hook_layer.__class__.__call__ = orig\n",
    "        print(f'Grad-CAM error: {e}')\n",
    "        return None\n",
    "\n",
    "\n",
    "print('Funcții Grad-CAM definite (hook-based, Keras 3 compatible).')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Încărcăm modelul antrenat\n",
    "MODEL_PATH = 'models/resnet_model.keras'\n",
    "trained_model = None\n",
    "\n",
    "if os.path.exists(MODEL_PATH):\n",
    "    custom_reg = keras.saving.get_custom_objects()\n",
    "    custom_reg['ResidualBlock'] = ResidualBlock\n",
    "    trained_model = tf.keras.models.load_model(MODEL_PATH)\n",
    "    print(f'Model încărcat: {MODEL_PATH}')\n",
    "    print(f'Parametri: {trained_model.count_params():,}')\n",
    "else:\n",
    "    print('Model negăsit — rulați retrain.py pentru a-l antrena.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demonstrație Grad-CAM pe 4 imagini din test set\n",
    "if trained_model is not None:\n",
    "    hook_layer = find_gradcam_layer(trained_model)\n",
    "    indices    = np.random.choice(len(X_test), 4, replace=False)\n",
    "\n",
    "    fig, axes = plt.subplots(4, 3, figsize=(10, 13), facecolor='#1a1a2e')\n",
    "    fig.suptitle('Grad-CAM — Analiză XAI pe 4 Mostre', color='white',\n",
    "                 fontsize=14, fontweight='bold', y=1.01)\n",
    "    for ax, ct in zip(axes[0], ['Input (28×28)', 'Heatmap Grad-CAM', 'Overlay']):\n",
    "        ax.set_title(ct, color='#a0a8d0', fontsize=10, pad=8)\n",
    "\n",
    "    for row, idx in enumerate(indices):\n",
    "        img  = X_test[idx]\n",
    "        arr  = img[np.newaxis]\n",
    "        prob = trained_model.predict(arr, verbose=0)[0]\n",
    "        pred = np.argmax(prob)\n",
    "        real = y_test[idx]\n",
    "\n",
    "        hm   = generate_gradcam(trained_model, arr, pred, hook_layer)\n",
    "        sc   = 10\n",
    "        orig = cv2.resize((img[:,:,0]*255).astype(np.uint8), (28*sc, 28*sc),\n",
    "                          interpolation=cv2.INTER_NEAREST)\n",
    "        orig_rgb = cv2.cvtColor(orig, cv2.COLOR_GRAY2RGB)\n",
    "\n",
    "        correct = pred == real\n",
    "        lc = '#4ade80' if correct else '#f87171'\n",
    "        axes[row,0].imshow(orig, cmap='gray')\n",
    "        axes[row,0].set_ylabel(\n",
    "            f'Real: {CLASS_NAMES[real]}\\nPred: {CLASS_NAMES[pred]} ({prob[pred]*100:.1f}%)',\n",
