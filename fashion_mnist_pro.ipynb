    "---\n",
    "## 3. Preprocesare Inteligentă a Imaginilor <a id='3'></a>\n",
    "\n",
    "Fotografiile reale au fundal variat, iluminare neuniformă, și articolul nu e centrat automat.\n",
    "Pipeline-ul nostru rezolvă toate acestea în 4 pași înainte de a trimite imaginea în rețea."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def smart_preprocess(img_pil):\n",
    "    \"\"\"\n",
    "    Pipeline preprocesare inteligentă.\n",
    "    Returnează: (arr_1x28x28x1, dict_pasi_vizuali)\n",
    "    \"\"\"\n",
    "    steps = {}\n",
    "\n",
    "    # 1. Grayscale\n",
    "    gray = np.array(img_pil.convert('L'), dtype=np.uint8)\n",
    "    steps['1. Grayscale'] = gray\n",
    "\n",
    "    # 2. Detecție fundal — medierea colțurilor (10% din dimensiune)\n",
    "    h, w = gray.shape\n",
    "    m = max(1, min(h, w) // 10)\n",
    "    bg = np.mean([gray[:m,:m], gray[:m,w-m:], gray[h-m:,:m], gray[h-m:,w-m:]])\n",
    "\n",
    "    # 3. Inversare automată dacă fundalul e deschis (articol negru pe alb)\n",
    "    inverted = (255 - gray) if bg > 127 else gray.copy()\n",
    "    steps['2. Corecție fundal'] = inverted\n",
    "\n",
    "    # 4. CLAHE — contrast local adaptiv\n",
    "    clahe    = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(4, 4))\n",
    "    enhanced = clahe.apply(inverted)\n",
    "    steps['3. CLAHE'] = enhanced\n",
    "\n",
    "    # 5. Bounding-box crop + square pad + resize 28×28\n",
    "    _, binary = cv2.threshold(enhanced, 25, 255, cv2.THRESH_BINARY)\n",
    "    coords = cv2.findNonZero(binary)\n",
    "    if coords is not None:\n",
    "        x, y, bw, bh = cv2.boundingRect(coords)\n",
    "        pad = max(bw, bh) // 8\n",
    "        cropped = enhanced[max(0,y-pad):min(h,y+bh+pad),\n",
    "                            max(0,x-pad):min(w,x+bw+pad)]\n",
    "    else:\n",
    "        cropped = enhanced\n",
    "\n",
    "    side   = max(cropped.shape)\n",
    "    canvas = np.zeros((side, side), dtype=np.uint8)\n",
    "    oy = (side - cropped.shape[0]) // 2\n",
    "    ox = (side - cropped.shape[1]) // 2\n",
    "    canvas[oy:oy+cropped.shape[0], ox:ox+cropped.shape[1]] = cropped\n",
    "    final  = cv2.resize(canvas, (28, 28), interpolation=cv2.INTER_AREA)\n",
    "    steps['4. Final 28×28'] = final\n",
    "\n",
    "    arr = final.astype('float32') / 255.0\n",
    "    return arr[np.newaxis, :, :, np.newaxis], steps\n",
    "\n",
    "\n",
    "print('smart_preprocess() definit.')\n",
    "print('  Detecție fundal  : analiza medie colțuri 10%')\n",
    "print('  CLAHE            : clipLimit=3.0, tileGridSize=(4,4)')\n",
    "print('  Output           : (1, 28, 28, 1) float32 ∈ [0,1]')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demonstrație vizuală pipeline pe o imagine din testset\n",
