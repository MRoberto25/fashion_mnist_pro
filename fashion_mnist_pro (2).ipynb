        "# ============================================================\n",
        "#  IMPORTURI & CONFIGURARE\n",
        "# ============================================================\n",
        "import os\n",
        "os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.image as mpimg\n",
        "from tensorflow.keras import layers, models\n",
        "\n",
        "plt.style.use('dark_background')\n",
        "\n",
        "print(\"✅ Mediul de producție inițializat.\")\n",
        "print(f\"✅ TensorFlow versiune: {tf.__version__}\")\n",
        "print(f\"✅ NumPy versiune: {np.__version__}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "arch_md"
      },
      "source": [
        "---\n",
        "## 🧠 1. Arhitectura Modelului: ResNet Custom\n",
        "\n",
        "### De ce Skip Connections?\n",
        "\n",
        "Într-o rețea neurală adâncă, informația se poate pierde treptat pe măsură ce trece prin zeci de straturi de convoluție — fenomen cunoscut drept **Vanishing Gradient Problem**.\n",
        "\n",
        "Soluția noastră: blocuri de tip `ResidualBlock` cu **Skip Connections** care adună intrarea originală la ieșirea prelucrată:\n",
        "\n",
        "$$\\text{Output} = \\text{ReLU}\\bigl(F(x) + x\\bigr)$$\n",
        "\n",
        "Gradientul matematic poate astfel \"zbura\" nealterat prin rețea în timpul Backpropagation, permițând antrenarea unor rețele mult mai adânci și mai precise.\n",
        "\n",
        "| Caracteristică | CNN Clasic | ResNet Custom (al nostru) |\n",
        "|---|---|---|\n",
        "| Skip Connections | ❌ | ✅ |\n",
        "| Batch Normalization | Opțional | ✅ Per bloc |\n",
        "| GlobalAveragePooling | Rar | ✅ (reduce overfitting) |\n",
        "| Risc Vanishing Gradient | 🔴 Mare | 🟢 Minim |"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "model_cell"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "#  DEFINIREA ARHITECTURII ResidualBlock\n",
        "# ============================================================\n",
        "class ResidualBlock(layers.Layer):\n",
        "    \"\"\"Bloc rezidual custom cu Skip Connection și Batch Normalization.\"\"\"\n",
        "\n",
        "    def __init__(self, filters, stride=1, **kwargs):\n",
        "        super(ResidualBlock, self).__init__(**kwargs)\n",
        "        self.filters = filters\n",
        "        self.stride = stride\n",
        "\n",
        "        # Ramura principală\n",
        "        self.conv1 = layers.Conv2D(filters, 3, strides=stride, padding=\"same\", use_bias=False)\n",
        "        self.bn1   = layers.BatchNormalization()\n",
        "        self.relu1 = layers.ReLU()\n",
        "\n",
        "        self.conv2 = layers.Conv2D(filters, 3, strides=1, padding=\"same\", use_bias=False)\n",
        "        self.bn2   = layers.BatchNormalization()\n",
        "\n",
        "        # Ramura skip (shortcut) — necesară doar când dimensiunile se schimbă\n",
        "        if stride != 1:\n",
        "            self.shortcut_conv = layers.Conv2D(filters, 1, strides=stride, use_bias=False)\n",
        "            self.shortcut_bn   = layers.BatchNormalization()\n",
        "\n",
        "        self.add   = layers.Add()\n",
        "        self.relu2 = layers.ReLU()\n",
        "\n",
        "    def call(self, inputs, training=False):\n",
        "        # Ramura principală: Conv → BN → ReLU → Conv → BN\n",
        "        x = self.relu1(self.bn1(self.conv1(inputs), training=training))\n",
        "        x = self.bn2(self.conv2(x), training=training)\n",
        "\n",
        "        # Ramura skip\n",
        "        if self.stride != 1:\n",
        "            shortcut = self.shortcut_bn(self.shortcut_conv(inputs), training=training)\n",
        "        else:\n",
        "            shortcut = inputs\n",
        "\n",
        "        # Combinare: F(x) + x → ReLU\n",
        "        return self.relu2(self.add([x, shortcut]))\n",
        "\n",
        "    def get_config(self):\n",
        "        config = super().get_config()\n",
        "        config.update({\"filters\": self.filters, \"stride\": self.stride})\n",
        "        return config\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "#  ÎNCĂRCAREA MODELULUI ANTRENAT\n",
        "# ============================================================\n",
        "MODEL_PATH = 'models/resnet_model.keras'\n",
        "\n",
        "print(f\"📦 Se încarcă modelul din: {MODEL_PATH}\")\n",
        "model = tf.keras.models.load_model(\n",
        "    MODEL_PATH,\n",
        "    custom_objects={'ResidualBlock': ResidualBlock}\n",
        ")\n",
        "\n",
        "print(\"\\n✅ Model încărcat cu succes! Arhitectura completă:\")\n",
        "model.summary(line_length=80)"
      ]
    },
    {
